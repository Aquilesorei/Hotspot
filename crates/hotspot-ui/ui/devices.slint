import { Theme } from "theme.slint";
import { Card, Chip, Divider, Icon, IconButton, NoticeKind, PopupItem, Row } from "components.slint";
import { AppState, Client, Dialog } from "state.slint";

export component ClientRow inherits Rectangle {
    in property <Client> client;
    property <bool> no-internet: client.internet-cut || AppState.internet-cut-all;
    min-height: row.preferred-height;
    row := HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: root.no-internet ? Theme.warn-soft : Theme.surface-2;
            Icon {
                source: root.client.hostname != "" ? @image-url("icons/laptop.svg") : @image-url("icons/phone.svg");
                tint: root.no-internet ? Theme.warn : Theme.text-2;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.client.portal-name != "" ? root.client.portal-name
                    : root.client.hostname != "" ? root.client.hostname : "Unknown device";
                color: root.client.hostname != "" || root.client.portal-name != "" ? Theme.text : Theme.text-2;
                font-size: Theme.body;
                font-weight: root.client.hostname != "" || root.client.portal-name != "" ? 700 : 600;
            }
            if root.client.portal-phone != "": Text {
                text: root.client.portal-phone;
                color: Theme.text-2;
                font-size: Theme.caption;
            }
            if root.client.portal-name == "" && AppState.current.portal: Text {
                text: "Not signed in yet";
                color: Theme.warn;
                font-size: Theme.caption;
            }
            if root.client.ip != "": Text {
                text: root.client.ip;
                color: Theme.text;
                font-family: Theme.mono;
                font-size: Theme.caption;
            }
            Text {
                text: root.client.mac;
                color: Theme.text-2;
                font-family: Theme.mono;
                font-size: Theme.caption;
            }
            Text {
                text: root.client.connected;
                color: Theme.text-2;
                font-size: Theme.caption;
            }
            if root.client.usage != "": Text {
                text: root.client.usage;
                color: Theme.text-2;
                font-size: Theme.caption;
            }
            if root.client.expires != "" || root.client.speed != "" || root.client.portal-left != "": HorizontalLayout {
                padding-top: 4px;
                spacing: 6px;
                if root.client.portal-left != "": Chip {
                    text: root.client.portal-left;
                    has-icon: true;
                    icon: @image-url("icons/clock.svg");
                }
                if root.client.expires != "": Chip {
                    text: root.client.expires;
                    has-icon: true;
                    icon: @image-url("icons/clock.svg");
                }
                if root.client.speed != "": Chip {
                    text: root.client.speed;
                    has-icon: true;
                    icon: @image-url("icons/gauge.svg");
                }
                Rectangle { }
            }
            if root.no-internet: HorizontalLayout {
                padding-top: 4px;
                Chip {
                    text: AppState.internet-cut-all ? "No internet" : "Internet cut";
                    neutral: false;
                    kind: NoticeKind.warn;
                    has-icon: true;
                    icon: @image-url("icons/globe-off.svg");
                }
                Rectangle { }
            }
        }
        VerticalLayout {
            alignment: start;
            more := IconButton {
                icon: @image-url("icons/more.svg");
                label: "More actions";
                clicked => { menu.show(); }
            }
        }
    }
    menu := PopupWindow {
        x: root.width - 200px;
        y: 12px + 44px + 4px;
        width: 200px;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-control;
            border-radius: 8px;
            VerticalLayout {
                padding: 4px;
                if !root.client.internet-cut: PopupItem {
                    text: "Cut internet";
                    icon: @image-url("icons/globe-off.svg");
                    enabled: !AppState.internet-cut-all;
                    clicked => { AppState.set-client-cut(root.client.mac, true); }
                }
                if root.client.internet-cut: PopupItem {
                    text: "Restore internet";
                    icon: @image-url("icons/globe.svg");
                    enabled: !AppState.internet-cut-all;
                    clicked => { AppState.set-client-cut(root.client.mac, false); }
                }
                PopupItem {
                    text: "Rename device…";
                    icon: @image-url("icons/tag.svg");
                    clicked => { AppState.open-dialog(Dialog.rename, root.client.mac); }
                }
                PopupItem {
                    text: root.client.expires != "" ? "Change time limit…" : "Allow for…";
                    icon: @image-url("icons/clock.svg");
                    clicked => { AppState.open-dialog(Dialog.time-limit, root.client.mac); }
                }
                PopupItem {
                    text: "Limit speed…";
                    icon: @image-url("icons/gauge.svg");
                    clicked => { AppState.open-dialog(Dialog.speed-limit, root.client.mac); }
                }
                if root.client.portal-name != "": PopupItem {
                    text: "End portal session";
                    icon: @image-url("icons/x.svg");
                    clicked => { AppState.end-session(root.client.mac); }
                }
                if !root.client.blocked: PopupItem {
                    text: "Block device";
                    icon: @image-url("icons/ban.svg");
                    danger: true;
                    clicked => { AppState.block(root.client.mac); }
                }
                if root.client.blocked: PopupItem {
                    text: "Unblock device";
                    icon: @image-url("icons/ban.svg");
                    clicked => { AppState.unblock(root.client.mac); }
                }
            }
        }
    }
}

export component DevicesCard inherits Card {
    Row {
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: "Devices · \{AppState.clients.length}";
                color: Theme.text;
                font-size: Theme.title;
                font-weight: 700;
            }
            if AppState.internet-cut-all: Text {
                text: "Internet is cut for everyone";
                color: Theme.warn;
                font-size: Theme.caption;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/more.svg");
                label: "Actions for all devices";
                clicked => { all-menu.show(); }
            }
        }
    }
    all-menu := PopupWindow {
        x: root.width - 16px - 240px;
        y: 4px + 44px + 4px;
        width: 240px;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-control;
            border-radius: 8px;
            VerticalLayout {
                padding: 4px;
                if !AppState.internet-cut-all: PopupItem {
                    text: "Cut internet for everyone";
                    icon: @image-url("icons/globe-off.svg");
                    clicked => { AppState.set-cut-all(true); }
                }
                if AppState.internet-cut-all: PopupItem {
                    text: "Restore internet for everyone";
                    icon: @image-url("icons/globe.svg");
                    clicked => { AppState.set-cut-all(false); }
                }
                PopupItem {
                    text: "Block all devices";
                    icon: @image-url("icons/ban.svg");
                    danger: true;
                    enabled: AppState.clients.length > 0;
                    clicked => {
                        AppState.dialog-count = AppState.clients.length;
                        AppState.dialog = Dialog.block-all;
                    }
                }
                PopupItem {
                    text: "Unblock all devices";
                    icon: @image-url("icons/ban.svg");
                    enabled: AppState.blocked.length > 0;
                    clicked => { AppState.unblock-all(); }
                }
            }
        }
    }
    Divider { }
    if AppState.clients.length == 0: VerticalLayout {
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 4px;
        Text {
            text: "No devices connected yet";
            color: Theme.text;
            font-size: Theme.body;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: "Join “\{AppState.current.ssid}” from another device.";
            color: Theme.text-2;
            font-size: Theme.caption;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    for client[i] in AppState.clients: VerticalLayout {
        if i > 0: Divider { }
        ClientRow {
            client: client;
        }
    }
}
