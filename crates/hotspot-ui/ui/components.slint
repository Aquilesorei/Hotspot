import { Theme } from "theme.slint";

export enum ButtonKind { primary, danger, secondary, secondary-danger }
export enum StatusKind { off, busy, on, cut }
export enum NoticeKind { info, warn, error }

export component Card inherits Rectangle {
    in property <length> pad-v: 4px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: root.pad-v;
        padding-bottom: root.pad-v;
        @children
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component Icon inherits Image {
    in property <color> tint: Theme.text;
    width: 20px;
    height: 20px;
    colorize: tint;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <ButtonKind> kind: primary;
    in property <bool> enabled: true;
    in property <bool> small: false;
    callback clicked();

    property <color> fill: kind == ButtonKind.primary ? Theme.accent : kind == ButtonKind.danger ? Theme.danger-fill : Theme.surface;
    property <color> fg: kind == ButtonKind.primary ? Theme.on-accent
        : kind == ButtonKind.danger ? Theme.on-danger-fill
        : kind == ButtonKind.secondary-danger ? Theme.error : Theme.text;
    property <bool> outlined: kind == ButtonKind.secondary || kind == ButtonKind.secondary-danger;

    height: small ? 40px : 44px;
    border-radius: 8px;
    background: !enabled ? Theme.disabled-bg : ta.pressed ? fill.darker(15%) : ta.has-hover ? fill.darker(7%) : fill;
    border-width: outlined && enabled ? 1px : 0px;
    border-color: kind == ButtonKind.secondary-danger ? Theme.error-border : Theme.border-control;
    accessible-role: button;
    accessible-label: text;

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 16px;
        padding-right: 16px;
        if root.has-icon: Icon {
            source: root.icon;
            tint: root.enabled ? root.fg : Theme.disabled-text;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.enabled ? root.fg : Theme.disabled-text;
            font-size: root.small ? Theme.small : Theme.body;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: enabled && ta.has-hover ? Theme.surface-2 : transparent;
    accessible-role: button;
    accessible-label: label;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Icon {
        source: root.icon;
        tint: root.enabled ? Theme.text : Theme.disabled-text;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <NoticeKind> kind: info;
    in property <bool> neutral: true;
    height: 22px;
    border-radius: 11px;
    background: neutral ? Theme.surface-2 : kind == NoticeKind.warn ? Theme.warn-soft : kind == NoticeKind.error ? Theme.error-soft : Theme.info-soft;
    property <color> fg: neutral ? Theme.text-2 : kind == NoticeKind.warn ? Theme.warn : kind == NoticeKind.error ? Theme.error : Theme.info;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        if root.has-icon: Icon {
            source: root.icon;
            tint: root.fg;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.caption;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component Banner inherits Rectangle {
    in property <NoticeKind> kind: info;
    in property <string> title;
    in property <string> body;
    in property <string> details;
    in property <bool> dismissible: true;
    callback dismissed();
    property <bool> expanded: false;

    background: kind == NoticeKind.warn ? Theme.warn-soft : kind == NoticeKind.error ? Theme.error-soft : Theme.info-soft;
    border-width: 1px;
    border-color: kind == NoticeKind.warn ? Theme.warn-border : kind == NoticeKind.error ? Theme.error-border : Theme.info-border;
    border-radius: 12px;
    property <color> fg: kind == NoticeKind.warn ? Theme.warn : kind == NoticeKind.error ? Theme.error : Theme.info;
    accessible-role: text;
    accessible-label: title;

    HorizontalLayout {
        padding: 12px;
        spacing: 8px;
        Icon {
            source: root.kind == NoticeKind.info ? @image-url("icons/info.svg") : @image-url("icons/alert.svg");
            tint: root.fg;
        }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: root.title;
                color: root.fg;
                font-size: Theme.body;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: root.body;
                color: Theme.text;
                font-size: Theme.small;
                wrap: word-wrap;
            }
            if root.details != "": Text {
                text: root.expanded ? "Hide details" : "Show details";
                color: Theme.accent;
                font-size: Theme.small;
                font-weight: 600;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.expanded = !root.expanded; }
                }
            }
            if root.expanded: Rectangle {
                background: Theme.surface;
                border-radius: 8px;
                max-height: 160px;
                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: root.details;
                    color: Theme.text;
                    font-family: Theme.mono;
                    font-size: Theme.caption;
                    wrap: word-wrap;
                }
            }
        }
        if root.dismissible: IconButton {
            icon: @image-url("icons/x.svg");
            label: root.kind == NoticeKind.error ? "Dismiss error" : "Dismiss notice";
            width: 32px;
            height: 32px;
            clicked => { root.dismissed(); }
        }
    }
}

export component StatusCard inherits Card {
    in property <StatusKind> kind: off;
    in property <string> title;
    in property <string> subtitle;
    pad-v: 16px;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: root.kind == StatusKind.on ? Theme.ok-soft : root.kind == StatusKind.busy ? Theme.accent-soft : root.kind == StatusKind.cut ? Theme.warn-soft : Theme.surface-2;
            Icon {
                width: 24px;
                height: 24px;
                source: root.kind == StatusKind.off ? @image-url("icons/wifi-off.svg") : @image-url("icons/wifi.svg");
                tint: root.kind == StatusKind.on ? Theme.ok : root.kind == StatusKind.busy ? Theme.accent : root.kind == StatusKind.cut ? Theme.warn : Theme.text-2;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.title;
                font-weight: 700;
            }
            Text {
                text: root.subtitle;
                color: Theme.text-2;
                font-size: Theme.small;
                wrap: word-wrap;
            }
        }
    }
}

export component Row inherits HorizontalLayout {
    min-height: 48px;
    spacing: 8px;
}

export component LabeledValue inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;
    spacing: 2px;
    Text {
        text: root.label;
        color: Theme.text-2;
        font-size: Theme.caption;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-size: Theme.body;
        font-weight: 600;
        font-family: root.mono ? Theme.mono : "";
    }
}

/// A whole-card button that opens a sheet. The touch area covers the card: inside a `Card`,
/// it would be laid out as one more row of zero height.
export component LinkCard inherits Rectangle {
    in property <string> text;
    in property <string> value;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked();
    min-height: 56px;
    background: ta.has-hover ? Theme.surface-2 : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    accessible-role: button;
    accessible-label: text;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        if root.has-icon: Icon {
            source: root.icon;
            tint: Theme.text-2;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.body;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value;
            color: Theme.text-2;
            font-size: Theme.body;
            vertical-alignment: center;
        }
        Icon {
            source: @image-url("icons/chevron-right.svg");
            tint: Theme.text-2;
            y: (parent.height - self.height) / 2;
        }
    }
}
