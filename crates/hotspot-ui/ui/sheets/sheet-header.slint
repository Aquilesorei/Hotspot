import { Theme } from "../theme.slint";
import { Divider, IconButton } from "../components.slint";
import { AppState } from "../state.slint";

export component SheetHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> back: false;
    height: 64px;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: back ? 8px : 16px;
        padding-right: 8px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        if root.back: IconButton {
            icon: @image-url("../icons/chevron-left.svg");
            label: "Back";
            clicked => { AppState.close-sheet(); }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.title;
                font-weight: 700;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-2;
                font-size: Theme.caption;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if !root.back: IconButton {
            icon: @image-url("../icons/x.svg");
            label: "Close";
            clicked => { AppState.close-sheet(); }
        }
    }
    Divider {
        y: parent.height - 1px;
    }
}
