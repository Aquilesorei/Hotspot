import { Theme } from "theme.slint";
import { AppState, Dialog, Sheet } from "state.slint";
import { MainView } from "main_view.slint";
import { ProfileSheet } from "sheets/profile.slint";
import { CouponsSheet, UsersSheet } from "sheets/portal.slint";
import { BlockedSheet } from "sheets/blocked.slint";
import { SettingsSheet } from "sheets/settings.slint";
import { ConfirmDialog, InputDialog } from "dialogs.slint";

// what the Rust side uses
export { Phase, Unsupported, Sheet, Dialog, Profile, Upstream, Client, UserRow, CouponRow, BlockedDevice, Notice, AppState } from "state.slint";
export { NoticeKind } from "components.slint";
export { Tray } from "tray.slint";

export component MainWindow inherits Window {
    title: "Hotspot";
    icon: @image-url("icons/app.svg");
    preferred-width: 400px;
    preferred-height: 640px;
    min-width: 360px;
    min-height: 520px;
    background: Theme.bg;

    if AppState.sheet == Sheet.none: MainView { }
    if AppState.sheet == Sheet.profile-new || AppState.sheet == Sheet.profile-edit: ProfileSheet { }
    if AppState.sheet == Sheet.blocked: BlockedSheet { }
    if AppState.sheet == Sheet.coupons: CouponsSheet { }
    if AppState.sheet == Sheet.users: UsersSheet { }
    if AppState.sheet == Sheet.settings: SettingsSheet { }
    if AppState.dialog == Dialog.restart || AppState.dialog == Dialog.delete || AppState.dialog == Dialog.close || AppState.dialog == Dialog.block-all: ConfirmDialog {
        width: parent.width;
        height: parent.height;
    }
    if AppState.dialog == Dialog.rename || AppState.dialog == Dialog.time-limit || AppState.dialog == Dialog.speed-limit: InputDialog {
        width: parent.width;
        height: parent.height;
    }
}
