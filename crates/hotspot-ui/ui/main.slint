import { CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Banner, Button, LinkCard, ButtonKind, Card, Chip, Divider, Icon, IconButton, LabeledValue, NoticeKind, Row, StatusCard, StatusKind } from "components.slint";

export { NoticeKind }

export enum Phase { no-profile, stopped, authorizing, starting, running, stopping }
export enum Unsupported { none, no-ap-sta, no-upstream }
export enum Sheet { none, profile-new, profile-edit, blocked, coupons, users, settings }
export enum Dialog { none, restart, delete, close, block-all, rename, time-limit, speed-limit }

export struct Profile {
    name: string,
    ssid: string,
    password: string,
    hidden: bool,
    max-clients: string,
    portal: bool,
}

export struct Upstream {
    connected: bool,
    ssid: string,
    iface: string,
    channel: int,
    freq-mhz: int,
    band: string,
}

export struct Client {
    mac: string,
    ip: string,
    hostname: string,
    connected: string,
    internet-cut: bool,
    blocked: bool,
    usage: string,
    expires: string,
    speed: string,
    // captive portal session, if any
    portal-name: string,
    portal-phone: string,
    portal-left: string,
}

export struct UserRow {
    name: string,
    phone: string,
    coupon: string,
    mac: string,
    ip: string,
    status: string,
    // 0 active, 1 expired, 2 signed out, 3 ended
    status-kind: int,
    online: bool,
    left: string,
    first: string,
    last: string,
    history: [string],
}

export struct CouponRow {
    code: string,
    duration: string,
    mode: string,
    state: string,
    // 0 new, 1 in use, 2 used up, 3 revoked
    state-kind: int,
    left: string,
    devices: string,
}

export struct BlockedDevice {
    mac: string,
    name: string,
}

export struct Notice {
    id: string,
    kind: NoticeKind,
    title: string,
    body: string,
    dismissible: bool,
    details: string,
}

export global AppState {
    in-out property <[Profile]> profiles;
    in-out property <[string]> profile-labels: ["No profile"];
    in-out property <int> selected: -1;
    in-out property <Phase> phase: no-profile;
    in-out property <Unsupported> unsupported: none;
    in-out property <Upstream> upstream;
    in-out property <[Notice]> notices;
    in-out property <bool> password-revealed;
    in-out property <bool> copied;
    in-out property <[BlockedDevice]> blocked;
    in-out property <string> running-profile;
    /// Connected to the background service: no password, and the hotspot outlives the window.
    in-out property <bool> service;
    /// A system tray is available: closing the window only hides it.
    in-out property <bool> tray;

    in-out property <[Client]> clients;
    in-out property <bool> internet-cut-all;
    in-out property <bool> qr-shown;
    in-out property <image> qr-image;

    in-out property <Sheet> sheet: none;
    in-out property <Dialog> dialog: none;
    in-out property <int> dialog-count;

    in-out property <string> form-name;
    in-out property <string> form-ssid;
    in-out property <string> form-password;
    in-out property <bool> form-password-revealed;
    in-out property <string> form-name-error;
    in-out property <string> form-ssid-error;
    in-out property <string> form-password-error;
    in-out property <int> form-ssid-bytes;
    in-out property <bool> form-attempted;
    in-out property <bool> form-hidden;
    in-out property <string> form-max;
    in-out property <string> form-max-error;

    // input dialogs (rename, time limit, speed limit)
    in-out property <string> dialog-mac;
    in-out property <string> dialog-input;
    in-out property <string> dialog-error;
    in-out property <[string]> dialog-presets;
    in-out property <bool> dialog-can-remove;

    out property <Profile> current: selected >= 0 && selected < profiles.length ? profiles[selected] : { name: "", ssid: "", password: "", hidden: false, max-clients: "", portal: false };
    out property <bool> idle: phase == Phase.stopped || phase == Phase.no-profile;
    out property <bool> busy: phase == Phase.authorizing || phase == Phase.starting;
    out property <bool> can-start: phase == Phase.stopped && unsupported == Unsupported.none && upstream.connected
        && (!current.portal || service);
    out property <bool> form-valid: form-name-error == "" && form-ssid-error == "" && form-password-error == "" && form-max-error == ""
        && (!form-portal || form-portal-error == "");
    out property <bool> editing-running: sheet == Sheet.profile-edit && phase == Phase.running && current.name == running-profile;

    callback select-profile(int);
    callback start();
    callback stop();
    callback new-profile();
    callback edit-profile();
    callback open-blocked();
    callback close-sheet();
    callback copy-password();
    callback dismiss-notice(string);
    callback toggle-qr();
    callback set-cut-all(bool);
    callback set-client-cut(string, bool);
    callback block(string);
    callback unblock(string);
    callback unblock-all();

    // captive portal
    in-out property <bool> form-portal;
    in-out property <[string]> country-labels;
    in-out property <int> form-country;
    in-out property <bool> form-connected;
    in-out property <string> form-devices: "1";
    in-out property <string> form-portal-error;
    in-out property <[CouponRow]> coupons;
    in-out property <[UserRow]> users;
    in-out property <string> users-filter;
    in-out property <string> form-durations;
    in-out property <bool> notifications: true;
    in-out property <bool> autostart;
    in-out property <[string]> coupon-durations;
    in-out property <string> cf-count: "10";
    in-out property <int> cf-duration: 3;
    in-out property <string> cf-custom;
    in-out property <bool> cf-connected;
    in-out property <string> cf-devices: "1";
    in-out property <string> cf-error;
    callback open-coupons();
    callback open-users();
    callback filter-users();
    callback export-users();
    callback set-notifications(bool);
    callback set-autostart(bool);
    callback create-coupons();
    callback coupon-action(string, string);
    callback export-coupons();
    callback end-session(string);
    callback form-changed();
    callback save-profile();
    callback delete-profile();
    callback confirm-dialog();
    callback generate-password();
    callback open-dialog(Dialog, string);
    callback dialog-preset(int);
    callback dialog-apply();
    callback dialog-remove();
}

component SheetHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> back: false;
    height: 64px;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: back ? 8px : 16px;
        padding-right: 8px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        if root.back: IconButton {
            icon: @image-url("icons/chevron-left.svg");
            label: "Back";
            clicked => { AppState.close-sheet(); }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.title;
                font-weight: 700;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-2;
                font-size: Theme.caption;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if !root.back: IconButton {
            icon: @image-url("icons/x.svg");
            label: "Close";
            clicked => { AppState.close-sheet(); }
        }
    }
    Divider {
        y: parent.height - 1px;
    }
}

component Header inherits Rectangle {
    height: 64px;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        ComboBox {
            model: AppState.profile-labels;
            current-index: max(AppState.selected, 0);
            enabled: AppState.phase == Phase.stopped;
            selected => { AppState.select-profile(self.current-index); }
        }
        IconButton {
            icon: @image-url("icons/edit.svg");
            label: "Edit profile";
            enabled: AppState.phase != Phase.no-profile && !AppState.busy && AppState.phase != Phase.stopping;
            clicked => { AppState.edit-profile(); }
        }
        IconButton {
            icon: @image-url("icons/plus.svg");
            label: "New profile";
            enabled: !AppState.busy && AppState.phase != Phase.stopping;
            clicked => { AppState.new-profile(); }
        }
        IconButton {
            icon: @image-url("icons/settings.svg");
            label: "Settings";
            clicked => { AppState.sheet = Sheet.settings; }
        }
    }
    Divider {
        y: parent.height - 1px;
    }
}

component EmptyState inherits Card {
    pad-v: 24px;
    VerticalLayout {
        spacing: 12px;
        alignment: center;
        Text {
            text: "No profile yet";
            color: Theme.text;
            font-size: Theme.title;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "A profile saves the network name and password for your hotspot.";
            color: Theme.text-2;
            font-size: Theme.body;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Button {
            text: "Create a profile";
            has-icon: true;
            icon: @image-url("icons/plus.svg");
            clicked => { AppState.new-profile(); }
        }
    }
}

component HotspotCard inherits Card {
    Row {
        LabeledValue {
            label: "Network name";
            value: AppState.current.ssid;
        }
    }
    Divider { }
    if AppState.current.portal: Row {
        LabeledValue {
            label: "Access";
            value: "Open network · coupon required";
        }
    }
    if !AppState.current.portal: Row {
        LabeledValue {
            label: "Password";
            value: AppState.password-revealed ? AppState.current.password : "••••••••••";
            mono: AppState.password-revealed;
        }
        IconButton {
            icon: AppState.password-revealed ? @image-url("icons/eye-off.svg") : @image-url("icons/eye.svg");
            label: AppState.password-revealed ? "Hide password" : "Show password";
            clicked => { AppState.password-revealed = !AppState.password-revealed; }
        }
        IconButton {
            icon: AppState.copied ? @image-url("icons/check.svg") : @image-url("icons/copy.svg");
            label: AppState.copied ? "Copied" : "Copy password";
            clicked => { AppState.copy-password(); }
        }
    }
    if AppState.phase == Phase.running: Divider { }
    if AppState.phase == Phase.running: VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        if AppState.qr-shown: VerticalLayout {
            spacing: 8px;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 216px;
                    height: 216px;
                    border-radius: 10px;
                    background: white;
                    Image {
                        width: 200px;
                        height: 200px;
                        source: AppState.qr-image;
                        image-rendering: pixelated;
                    }
                }
            }
            Text {
                text: "Scan with a phone camera to join. The QR code contains the password.";
                color: Theme.text-2;
                font-size: Theme.caption;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
        Button {
            text: AppState.qr-shown ? "Hide QR code" : "Show QR code";
            kind: ButtonKind.secondary;
            small: true;
            has-icon: true;
            icon: @image-url("icons/qr.svg");
            clicked => { AppState.toggle-qr(); }
        }
    }
}

component PopupItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    border-radius: 6px;
    background: enabled && ta.has-hover ? (danger ? Theme.error-soft : Theme.surface-2) : transparent;
    property <color> fg: !enabled ? Theme.disabled-text : danger ? Theme.error : Theme.text;
    accessible-role: button;
    accessible-label: text;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Icon {
            source: root.icon;
            tint: root.fg;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.small;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component ClientRow inherits Rectangle {
    in property <Client> client;
    property <bool> no-internet: client.internet-cut || AppState.internet-cut-all;
    min-height: row.preferred-height;
    row := HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: root.no-internet ? Theme.warn-soft : Theme.surface-2;
            Icon {
                source: root.client.hostname != "" ? @image-url("icons/laptop.svg") : @image-url("icons/phone.svg");
                tint: root.no-internet ? Theme.warn : Theme.text-2;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.client.portal-name != "" ? root.client.portal-name
                    : root.client.hostname != "" ? root.client.hostname : "Unknown device";
                color: root.client.hostname != "" || root.client.portal-name != "" ? Theme.text : Theme.text-2;
                font-size: Theme.body;
                font-weight: root.client.hostname != "" || root.client.portal-name != "" ? 700 : 600;
            }
            if root.client.portal-phone != "": Text {
                text: root.client.portal-phone;
                color: Theme.text-2;
                font-size: Theme.caption;
            }
            if root.client.portal-name == "" && AppState.current.portal: Text {
                text: "Not signed in yet";
                color: Theme.warn;
                font-size: Theme.caption;
            }
            if root.client.ip != "": Text {
                text: root.client.ip;
                color: Theme.text;
                font-family: Theme.mono;
                font-size: Theme.caption;
            }
            Text {
                text: root.client.mac;
                color: Theme.text-2;
                font-family: Theme.mono;
                font-size: Theme.caption;
            }
            Text {
                text: root.client.connected;
                color: Theme.text-2;
                font-size: Theme.caption;
            }
            if root.client.usage != "": Text {
                text: root.client.usage;
                color: Theme.text-2;
                font-size: Theme.caption;
            }
            if root.client.expires != "" || root.client.speed != "" || root.client.portal-left != "": HorizontalLayout {
                padding-top: 4px;
                spacing: 6px;
                if root.client.portal-left != "": Chip {
                    text: root.client.portal-left;
                    has-icon: true;
                    icon: @image-url("icons/clock.svg");
                }
                if root.client.expires != "": Chip {
                    text: root.client.expires;
                    has-icon: true;
                    icon: @image-url("icons/clock.svg");
                }
                if root.client.speed != "": Chip {
                    text: root.client.speed;
                    has-icon: true;
                    icon: @image-url("icons/gauge.svg");
                }
                Rectangle { }
            }
            if root.no-internet: HorizontalLayout {
                padding-top: 4px;
                Chip {
                    text: AppState.internet-cut-all ? "No internet" : "Internet cut";
                    neutral: false;
                    kind: NoticeKind.warn;
                    has-icon: true;
                    icon: @image-url("icons/globe-off.svg");
                }
                Rectangle { }
            }
        }
        VerticalLayout {
            alignment: start;
            more := IconButton {
                icon: @image-url("icons/more.svg");
                label: "More actions";
                clicked => { menu.show(); }
            }
        }
    }
    menu := PopupWindow {
        x: root.width - 200px;
        y: 12px + 44px + 4px;
        width: 200px;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-control;
            border-radius: 8px;
            VerticalLayout {
                padding: 4px;
                if !root.client.internet-cut: PopupItem {
                    text: "Cut internet";
                    icon: @image-url("icons/globe-off.svg");
                    enabled: !AppState.internet-cut-all;
                    clicked => { AppState.set-client-cut(root.client.mac, true); }
                }
                if root.client.internet-cut: PopupItem {
                    text: "Restore internet";
                    icon: @image-url("icons/globe.svg");
                    enabled: !AppState.internet-cut-all;
                    clicked => { AppState.set-client-cut(root.client.mac, false); }
                }
                PopupItem {
                    text: "Rename device…";
                    icon: @image-url("icons/tag.svg");
                    clicked => { AppState.open-dialog(Dialog.rename, root.client.mac); }
                }
                PopupItem {
                    text: root.client.expires != "" ? "Change time limit…" : "Allow for…";
                    icon: @image-url("icons/clock.svg");
                    clicked => { AppState.open-dialog(Dialog.time-limit, root.client.mac); }
                }
                PopupItem {
                    text: "Limit speed…";
                    icon: @image-url("icons/gauge.svg");
                    clicked => { AppState.open-dialog(Dialog.speed-limit, root.client.mac); }
                }
                if root.client.portal-name != "": PopupItem {
                    text: "End portal session";
                    icon: @image-url("icons/x.svg");
                    clicked => { AppState.end-session(root.client.mac); }
                }
                if !root.client.blocked: PopupItem {
                    text: "Block device";
                    icon: @image-url("icons/ban.svg");
                    danger: true;
                    clicked => { AppState.block(root.client.mac); }
                }
                if root.client.blocked: PopupItem {
                    text: "Unblock device";
                    icon: @image-url("icons/ban.svg");
                    clicked => { AppState.unblock(root.client.mac); }
                }
            }
        }
    }
}

component DevicesCard inherits Card {
    Row {
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: "Devices · \{AppState.clients.length}";
                color: Theme.text;
                font-size: Theme.title;
                font-weight: 700;
            }
            if AppState.internet-cut-all: Text {
                text: "Internet is cut for everyone";
                color: Theme.warn;
                font-size: Theme.caption;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/more.svg");
                label: "Actions for all devices";
                clicked => { all-menu.show(); }
            }
        }
    }
    all-menu := PopupWindow {
        x: root.width - 16px - 240px;
        y: 4px + 44px + 4px;
        width: 240px;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-control;
            border-radius: 8px;
            VerticalLayout {
                padding: 4px;
                if !AppState.internet-cut-all: PopupItem {
                    text: "Cut internet for everyone";
                    icon: @image-url("icons/globe-off.svg");
                    clicked => { AppState.set-cut-all(true); }
                }
                if AppState.internet-cut-all: PopupItem {
                    text: "Restore internet for everyone";
                    icon: @image-url("icons/globe.svg");
                    clicked => { AppState.set-cut-all(false); }
                }
                PopupItem {
                    text: "Block all devices";
                    icon: @image-url("icons/ban.svg");
                    danger: true;
                    enabled: AppState.clients.length > 0;
                    clicked => {
                        AppState.dialog-count = AppState.clients.length;
                        AppState.dialog = Dialog.block-all;
                    }
                }
                PopupItem {
                    text: "Unblock all devices";
                    icon: @image-url("icons/ban.svg");
                    enabled: AppState.blocked.length > 0;
                    clicked => { AppState.unblock-all(); }
                }
            }
        }
    }
    Divider { }
    if AppState.clients.length == 0: VerticalLayout {
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 4px;
        Text {
            text: "No devices connected yet";
            color: Theme.text;
            font-size: Theme.body;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: "Join “\{AppState.current.ssid}” from another device.";
            color: Theme.text-2;
            font-size: Theme.caption;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    for client[i] in AppState.clients: VerticalLayout {
        if i > 0: Divider { }
        ClientRow {
            client: client;
        }
    }
}

component UpstreamCard inherits Card {
    pad-v: 16px;
    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Upstream Wi-Fi";
                color: Theme.text;
                font-size: Theme.title;
                font-weight: 700;
                vertical-alignment: center;
            }
            Chip {
                text: "Read-only";
                has-icon: true;
                icon: @image-url("icons/lock.svg");
            }
            Rectangle { }
        }
        GridLayout {
            spacing: 12px;
            Row {
                LabeledValue {
                    label: "Network";
                    value: AppState.upstream.connected ? AppState.upstream.ssid : "Not connected";
                }
                LabeledValue {
                    label: "Interface";
                    value: AppState.upstream.iface != "" ? AppState.upstream.iface : "None";
                }
            }
            Row {
                LabeledValue {
                    label: "Channel";
                    value: AppState.upstream.connected ? "\{AppState.upstream.channel} (\{AppState.upstream.freq-mhz} MHz)" : "None";
                }
                LabeledValue {
                    label: "Band";
                    value: AppState.upstream.connected ? AppState.upstream.band : "None";
                }
            }
        }
        if AppState.upstream.connected: Text {
            text: "Channel and band are set by \{AppState.upstream.ssid} and can't be changed here.";
            color: Theme.text-2;
            font-size: Theme.caption;
            wrap: word-wrap;
        }
    }
}


component CouponRowView inherits Rectangle {
    in property <CouponRow> coupon;
    min-height: row.preferred-height;
    row := HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.coupon.code;
                color: root.coupon.state-kind >= 2 ? Theme.text-2 : Theme.text;
                font-family: Theme.mono;
                font-size: Theme.title;
                font-weight: 700;
            }
            Text {
                text: "\{root.coupon.duration} · \{root.coupon.mode} · \{root.coupon.devices}";
                color: Theme.text-2;
                font-size: Theme.caption;
            }
            if root.coupon.left != "": Text {
                text: root.coupon.left;
                color: Theme.text-2;
                font-size: Theme.caption;
            }
        }
        Chip {
            text: root.coupon.state;
            neutral: root.coupon.state-kind == 0;
            kind: root.coupon.state-kind == 1 ? NoticeKind.info : root.coupon.state-kind == 3 ? NoticeKind.error : NoticeKind.warn;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            more := IconButton {
                icon: @image-url("icons/more.svg");
                label: "Coupon actions";
                clicked => { menu.show(); }
            }
        }
    }
    menu := PopupWindow {
        x: root.width - 200px;
        y: root.height - 4px;
        width: 200px;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-control;
            border-radius: 8px;
            VerticalLayout {
                padding: 4px;
                PopupItem {
                    text: "Copy code";
                    icon: @image-url("icons/copy.svg");
                    clicked => { AppState.coupon-action(root.coupon.code, "copy"); }
                }
                PopupItem {
                    text: "Add 1 hour";
                    icon: @image-url("icons/clock.svg");
                    enabled: root.coupon.state-kind != 3;
                    clicked => { AppState.coupon-action(root.coupon.code, "extend"); }
                }
                PopupItem {
                    text: "Revoke";
                    icon: @image-url("icons/ban.svg");
                    danger: true;
                    enabled: root.coupon.state-kind != 3;
                    clicked => { AppState.coupon-action(root.coupon.code, "revoke"); }
                }
            }
        }
    }
}

component SettingsSheet inherits VerticalLayout {
    SheetHeader {
        back: true;
        title: "Settings";
    }
    ScrollView {
        content-width: self.visible-width;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            Card {
                pad-v: 12px;
                VerticalLayout {
                    spacing: 4px;
                    CheckBox {
                        text: "Notifications";
                        checked <=> AppState.notifications;
                        toggled => { AppState.set-notifications(self.checked); }
                    }
                    Text {
                        text: "New devices, wrong passwords, portal sign-ins and ended guest access.";
                        color: Theme.text-2;
                        font-size: Theme.caption;
                        wrap: word-wrap;
                    }
                }
            }
            Card {
                pad-v: 12px;
                VerticalLayout {
                    spacing: 4px;
                    CheckBox {
                        text: "Start at login";
                        checked <=> AppState.autostart;
                        toggled => { AppState.set-autostart(self.checked); }
                    }
                    Text {
                        text: "Only the tray icon appears; click it to open this window.";
                        color: Theme.text-2;
                        font-size: Theme.caption;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

component UserRowView inherits Rectangle {
    in property <UserRow> user;
    property <bool> open;
    min-height: col.preferred-height;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open = !root.open; }
    }
    col := VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.user.name;
                color: root.user.status-kind == 0 ? Theme.text : Theme.text-2;
                font-size: Theme.body;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Chip {
                text: root.user.status;
                neutral: root.user.status-kind == 3;
                kind: root.user.status-kind == 0 ? NoticeKind.info : root.user.status-kind == 2 ? NoticeKind.error : NoticeKind.warn;
            }
        }
        Text {
            text: "\{root.user.phone} · coupon \{root.user.coupon}";
            color: Theme.text-2;
            font-size: Theme.caption;
        }
        Text {
            text: root.user.left != "" ? "\{root.user.left} · last seen \{root.user.last}" : "Last seen \{root.user.last}";
            color: Theme.text-2;
            font-size: Theme.caption;
        }
        if root.open: VerticalLayout {
            padding-top: 8px;
            spacing: 2px;
            Text {
                text: "MAC \{root.user.mac}" + (root.user.ip != "" ? " · IP \{root.user.ip}" : "");
                color: Theme.text-2;
                font-family: Theme.mono;
                font-size: Theme.caption;
            }
            Text {
                text: "First sign-in \{root.user.first}";
                color: Theme.text-2;
                font-size: Theme.caption;
            }
            Text {
                text: "History";
                color: Theme.text;
                font-size: Theme.small;
                font-weight: 600;
            }
            for line in root.user.history: Text {
                text: line;
                color: Theme.text-2;
                font-size: Theme.caption;
            }
            if root.user.status-kind == 0 && AppState.current.name == AppState.running-profile: HorizontalLayout {
                alignment: start;
                padding-top: 6px;
                Button {
                    text: "End session";
                    kind: ButtonKind.secondary;
                    small: true;
                    clicked => { AppState.end-session(root.user.mac); }
                }
            }
        }
    }
}

component UsersSheet inherits VerticalLayout {
    SheetHeader {
        back: true;
        title: "Users";
        subtitle: "Profile: \{AppState.current.name}";
    }
    ScrollView {
        // no sideways scrolling: content wraps or shrinks to the window
        content-width: self.visible-width;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            if !AppState.service: Banner {
                kind: NoticeKind.warn;
                title: "Users need the background service";
                body: "Run ./install.sh --service, then log out and back in once.";
                dismissible: false;
            }
            LineEdit {
                text <=> AppState.users-filter;
                placeholder-text: "Search name, phone, coupon, MAC or IP";
                edited => { AppState.filter-users(); }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: AppState.users.length == 0 ? (AppState.users-filter == "" ? "No one has signed in yet." : "No match.")
                        : "\{AppState.users.length} sign-ins · tap one for details. Kept 30 days after they end.";
                    color: Theme.text-2;
                    font-size: Theme.small;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Export CSV";
                    kind: ButtonKind.secondary;
                    small: true;
                    enabled: AppState.users.length > 0;
                    clicked => { AppState.export-users(); }
                }
            }
            if AppState.users.length > 0: Card {
                for user[i] in AppState.users: VerticalLayout {
                    if i > 0: Divider { }
                    UserRowView {
                        user: user;
                    }
                }
            }
        }
    }
}

component CouponsSheet inherits VerticalLayout {
    SheetHeader {
        back: true;
        title: "Coupons";
        subtitle: "Profile: \{AppState.current.name}";
    }
    ScrollView {
        // no sideways scrolling: content wraps or shrinks to the window
        content-width: self.visible-width;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            if !AppState.service: Banner {
                kind: NoticeKind.warn;
                title: "Coupons need the background service";
                body: "Run ./install.sh --service, then log out and back in once.";
                dismissible: false;
            }
            Card {
                pad-v: 16px;
                VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "Create coupons";
                        color: Theme.text;
                        font-size: Theme.title;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "How many";
                                color: Theme.text-2;
                                font-size: Theme.caption;
                            }
                            LineEdit {
                                text <=> AppState.cf-count;
                                input-type: InputType.number;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Duration";
                                color: Theme.text-2;
                                font-size: Theme.caption;
                            }
                            ComboBox {
                                model: AppState.coupon-durations;
                                current-index <=> AppState.cf-duration;
                            }
                        }
                    }
                    if AppState.cf-duration == AppState.coupon-durations.length - 1: LineEdit {
                        text <=> AppState.cf-custom;
                        placeholder-text: "Custom duration in minutes";
                        input-type: InputType.number;
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Devices per coupon";
                            color: Theme.text-2;
                            font-size: Theme.caption;
                        }
                        LineEdit {
                            text <=> AppState.cf-devices;
                            input-type: InputType.number;
                        }
                    }
                    CheckBox {
                        text: "Count only connected time";
                        checked <=> AppState.cf-connected;
                    }
                    if AppState.cf-error != "": Text {
                        text: AppState.cf-error;
                        color: Theme.error;
                        font-size: Theme.caption;
                        wrap: word-wrap;
                    }
                    Button {
                        text: "Create";
                        enabled: AppState.service;
                        clicked => { AppState.create-coupons(); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "\{AppState.coupons.length} coupons";
                    color: Theme.text-2;
                    font-size: Theme.small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Export CSV";
                    kind: ButtonKind.secondary;
                    small: true;
                    enabled: AppState.coupons.length > 0;
                    clicked => { AppState.export-coupons(); }
                }
            }
            if AppState.coupons.length > 0: Card {
                for coupon[i] in AppState.coupons: VerticalLayout {
                    if i > 0: Divider { }
                    CouponRowView {
                        coupon: coupon;
                    }
                }
            }
        }
    }
}


component Footer inherits Rectangle {
    background: Theme.surface;
    Divider {
        y: 0;
    }
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 16px;
        spacing: 8px;
        property <string> caption: AppState.phase == Phase.no-profile ? "Create a profile to start."
            : AppState.phase == Phase.running && AppState.service ? "The hotspot keeps running when you close this window."
            : AppState.phase == Phase.running && AppState.tray ? "Closing this window keeps the hotspot in the tray. Quit from the tray icon stops it."
            : AppState.phase == Phase.running ? "Closing this window stops the hotspot."
            : AppState.phase == Phase.stopped && !AppState.upstream.connected ? "Connect to a Wi-Fi network to start."
            : AppState.phase == Phase.stopped && AppState.current.portal && !AppState.service
                ? "Portal profiles need the background service: run ./install.sh --service." : "";
        if caption != "": Text {
            text: caption;
            color: Theme.text-2;
            font-size: Theme.caption;
            horizontal-alignment: center;
        }
        if AppState.phase == Phase.running || AppState.phase == Phase.stopping: Button {
            text: AppState.phase == Phase.stopping ? "Stopping…" : "Stop hotspot";
            kind: ButtonKind.danger;
            enabled: AppState.phase == Phase.running;
            clicked => { AppState.stop(); }
        }
        if AppState.phase != Phase.running && AppState.phase != Phase.stopping: Button {
            text: AppState.phase == Phase.authorizing ? "Waiting for authorization…" : AppState.phase == Phase.starting ? "Starting…" : "Start hotspot";
            enabled: AppState.can-start;
            clicked => { AppState.start(); }
        }
    }
}

component MainView inherits VerticalLayout {
    Header { }
    ScrollView {
        // no sideways scrolling: content wraps or shrinks to the window
        content-width: self.visible-width;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            for notice in AppState.notices: Banner {
                kind: notice.kind;
                title: notice.title;
                body: notice.body;
                details: notice.details;
                dismissible: notice.dismissible;
                dismissed => { AppState.dismiss-notice(notice.id); }
            }
            if AppState.phase == Phase.no-profile: EmptyState { }
            if AppState.phase != Phase.no-profile: StatusCard {
                kind: AppState.phase == Phase.running ? (AppState.internet-cut-all ? StatusKind.cut : StatusKind.on)
                    : AppState.busy ? StatusKind.busy : StatusKind.off;
                title: AppState.unsupported == Unsupported.no-ap-sta && AppState.idle ? "Hotspot is unavailable"
                    : AppState.phase == Phase.authorizing ? "Waiting for authorization…"
                    : AppState.phase == Phase.starting ? "Starting hotspot…"
                    : AppState.phase == Phase.running && AppState.internet-cut-all ? "Internet is cut for everyone"
                    : AppState.phase == Phase.running ? "Hotspot is on" : "Hotspot is off";
                subtitle: AppState.unsupported == Unsupported.no-ap-sta && AppState.idle ? "Your Wi-Fi card doesn't support this."
                    : AppState.phase == Phase.authorizing ? "Approve the system prompt to continue."
                    : AppState.phase == Phase.starting ? "This can take up to 10 seconds."
                    : AppState.phase == Phase.running && AppState.internet-cut-all
                        ? (AppState.clients.length == 1 ? "Hotspot is on · 1 device stays connected" : "Hotspot is on · \{AppState.clients.length} devices stay connected")
                    : AppState.phase == Phase.running
                        ? (AppState.clients.length == 0 ? "Sharing \{AppState.upstream.ssid} · No devices yet"
                            : AppState.clients.length == 1 ? "Sharing \{AppState.upstream.ssid} · 1 device"
                            : "Sharing \{AppState.upstream.ssid} · \{AppState.clients.length} devices")
                    : AppState.upstream.connected ? "Share the Wi-Fi from \{AppState.upstream.ssid} with other devices."
                    : "Connect to a Wi-Fi network to share it.";
            }
            if AppState.phase != Phase.no-profile: HotspotCard { }
            if AppState.phase == Phase.running: DevicesCard { }
            if AppState.phase != Phase.no-profile: UpstreamCard { }
            if AppState.phase != Phase.no-profile && AppState.current.portal: LinkCard {
                text: "Coupons";
                has-icon: true;
                icon: @image-url("icons/tag.svg");
                clicked => { AppState.open-coupons(); }
            }
            if AppState.phase != Phase.no-profile && AppState.current.portal: LinkCard {
                text: "Users";
                has-icon: true;
                icon: @image-url("icons/phone.svg");
                clicked => { AppState.open-users(); }
            }
            if AppState.phase != Phase.no-profile: LinkCard {
                text: "Blocked devices";
                value: AppState.blocked.length;
                clicked => { AppState.open-blocked(); }
            }
        }
    }
    Footer { }
}

component FormField inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> counter;
    in property <string> error;
    in property <bool> password: false;
    in property <bool> revealed: false;
    in property <bool> enabled: true;
    in property <bool> can-generate: false;
    in-out property <string> text;
    callback edited();
    callback toggle-reveal();
    callback generate();
    spacing: 6px;
    Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.small;
        font-weight: 600;
    }
    HorizontalLayout {
        spacing: 8px;
        LineEdit {
            text <=> root.text;
            enabled: root.enabled;
            input-type: root.password && !root.revealed ? InputType.password : InputType.text;
            edited => { root.edited(); }
        }
        if root.password: IconButton {
            icon: root.revealed ? @image-url("icons/eye-off.svg") : @image-url("icons/eye.svg");
            label: root.revealed ? "Hide password" : "Show password";
            clicked => { root.toggle-reveal(); }
        }
        if root.can-generate: IconButton {
            icon: @image-url("icons/dice.svg");
            label: "Generate a password";
            clicked => { root.generate(); }
        }
    }
    HorizontalLayout {
        Text {
            text: root.error != "" ? root.error : root.hint;
            color: root.error != "" ? Theme.error : Theme.text-2;
            font-size: Theme.caption;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        Text {
            text: root.counter;
            color: Theme.text-2;
            font-size: Theme.caption;
        }
    }
}

component ProfileSheet inherits VerticalLayout {
    SheetHeader {
        title: AppState.sheet == Sheet.profile-new ? "New profile" : "Edit profile";
    }
    ScrollView {
        // no sideways scrolling: content wraps or shrinks to the window
        content-width: self.visible-width;
        VerticalLayout {
            padding: 16px;
            spacing: 16px;
            alignment: start;
            if AppState.editing-running: Banner {
                kind: NoticeKind.info;
                title: "The hotspot is running";
                body: "Changing the network name or password restarts it and disconnects all devices.";
                dismissible: false;
            }
            FormField {
                label: "Profile name";
                enabled: !AppState.editing-running && !(AppState.sheet == Sheet.profile-edit && AppState.form-portal);
                hint: AppState.sheet == Sheet.profile-edit && AppState.form-portal ? "Portal profiles keep their coupons under this name, so it can't change."
                    : AppState.editing-running ? "Stop the hotspot to rename this profile." : "";
                text <=> AppState.form-name;
                error: AppState.form-attempted ? AppState.form-name-error : "";
                edited => { AppState.form-changed(); }
            }
            FormField {
                label: "Network name";
                hint: "1 to 32 bytes";
                counter: "\{AppState.form-ssid-bytes} / 32";
                text <=> AppState.form-ssid;
                error: AppState.form-attempted ? AppState.form-ssid-error : "";
                edited => { AppState.form-changed(); }
            }
            if AppState.sheet == Sheet.profile-new: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Profile type";
                    color: Theme.text;
                    font-size: Theme.small;
                    font-weight: 600;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        horizontal-stretch: 1;
                        small: true;
                        text: "Password";
                        kind: AppState.form-portal ? ButtonKind.secondary : ButtonKind.primary;
                        clicked => {
                            AppState.form-portal = false;
                            AppState.form-changed();
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        small: true;
                        text: "Portal with coupons";
                        kind: AppState.form-portal ? ButtonKind.primary : ButtonKind.secondary;
                        clicked => {
                            AppState.form-portal = true;
                            AppState.form-changed();
                        }
                    }
                }
                Text {
                    text: AppState.form-portal
                        ? "Open Wi-Fi: devices get internet after entering their details and a coupon code. Can't be changed later."
                        : "Devices join with a password. Can't be changed into a portal later.";
                    color: Theme.text-2;
                    font-size: Theme.caption;
                    wrap: word-wrap;
                }
            }
            if AppState.sheet == Sheet.profile-edit: Chip {
                text: AppState.form-portal ? "Portal profile · open network" : "Password profile";
                has-icon: true;
                icon: @image-url("icons/lock.svg");
            }
            if AppState.form-portal: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Default country";
                    color: Theme.text;
                    font-size: Theme.small;
                    font-weight: 600;
                }
                ComboBox {
                    model: AppState.country-labels;
                    current-index <=> AppState.form-country;
                }
                Text {
                    text: "Its calling code is preselected in the sign-in form. People can still pick another.";
                    color: Theme.text-2;
                    font-size: Theme.caption;
                    wrap: word-wrap;
                }
            }
            if AppState.form-portal: FormField {
                label: "Default devices per coupon";
                error: AppState.form-portal-error;
                text <=> AppState.form-devices;
                edited => { AppState.form-changed(); }
            }
            if AppState.form-portal: CheckBox {
                text: "New coupons count only connected time";
                checked <=> AppState.form-connected;
            }
            if AppState.form-portal: FormField {
                label: "Coupon durations offered";
                hint: "Separated by commas, e.g. 30 min, 2 h, 3 days, 1 week. \"Custom…\" is always offered too.";
                text <=> AppState.form-durations;
                edited => { AppState.form-changed(); }
            }
            if !AppState.form-portal: FormField {
                label: "Password";
                hint: "8 to 63 characters";
                counter: "\{AppState.form-password.character-count} / 63";
                password: true;
                revealed: AppState.form-password-revealed;
                text <=> AppState.form-password;
                error: AppState.form-attempted ? AppState.form-password-error : "";
                can-generate: true;
                edited => { AppState.form-changed(); }
                toggle-reveal => { AppState.form-password-revealed = !AppState.form-password-revealed; }
                generate => { AppState.generate-password(); }
            }
            VerticalLayout {
                spacing: 4px;
                CheckBox {
                    text: "Hidden network";
                    checked <=> AppState.form-hidden;
                }
                Text {
                    text: "Devices have to type the network name to join. The QR code still works.";
                    color: Theme.text-2;
                    font-size: Theme.caption;
                    wrap: word-wrap;
                }
            }
            FormField {
                label: "Max devices";
                hint: "Leave empty for no limit";
                text <=> AppState.form-max;
                error: AppState.form-max-error;
                edited => { AppState.form-changed(); }
            }
        }
    }
    Rectangle {
        background: Theme.surface;
        Divider {
            y: 0;
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 16px;
            spacing: 8px;
            if AppState.sheet == Sheet.profile-edit: Button {
                text: "Delete profile";
                kind: ButtonKind.secondary-danger;
                enabled: !(AppState.phase == Phase.running && AppState.current.name == AppState.running-profile);
                clicked => { AppState.dialog = Dialog.delete; }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Cancel";
                kind: ButtonKind.secondary;
                clicked => { AppState.close-sheet(); }
            }
            Button {
                text: "Save";
                clicked => {
                    AppState.form-attempted = true;
                    if AppState.form-valid {
                        AppState.save-profile();
                    }
                }
            }
        }
    }
}

component BlockedSheet inherits VerticalLayout {
    SheetHeader {
        back: true;
        title: "Blocked devices";
        subtitle: "Profile: \{AppState.current.name}";
    }
    ScrollView {
        // no sideways scrolling: content wraps or shrinks to the window
        content-width: self.visible-width;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            if AppState.blocked.length == 0: Text {
                text: "No blocked devices";
                color: Theme.text-2;
                font-size: Theme.body;
                horizontal-alignment: center;
            }
            if AppState.blocked.length > 0: Card {
                for device[i] in AppState.blocked: VerticalLayout {
                    if i > 0: Divider { }
                    VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: Theme.error-soft;
                                Icon {
                                    source: @image-url("icons/ban.svg");
                                    tint: Theme.error;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: device.name != "" ? device.name : "Unknown device";
                                    color: device.name != "" ? Theme.text : Theme.text-2;
                                    font-size: Theme.body;
                                    font-weight: device.name != "" ? 700 : 600;
                                }
                                Text {
                                    text: device.mac;
                                    color: Theme.text-2;
                                    font-family: Theme.mono;
                                    font-size: Theme.caption;
                                }
                            }
                            Chip {
                                text: "Blocked";
                                neutral: false;
                                kind: NoticeKind.error;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Button {
                            text: "Unblock";
                            kind: ButtonKind.secondary;
                            small: true;
                            clicked => { AppState.unblock(device.mac); }
                        }
                    }
                }
            }
            Text {
                text: "Blocked devices can't join this hotspot. The list is saved with the profile, so it applies whenever you use “\{AppState.current.name}”.";
                color: Theme.text-2;
                font-size: Theme.caption;
                wrap: word-wrap;
            }
        }
    }
}

component ConfirmDialog inherits Rectangle {
    background: Theme.dark ? #00000099 : #14181C73;
    TouchArea { }
    property <string> title: AppState.dialog == Dialog.block-all ? "Block all devices?"
        : AppState.dialog == Dialog.restart ? "Restart the hotspot?"
        : AppState.dialog == Dialog.delete ? "Delete “\{AppState.current.name}”?" : "Stop the hotspot?";
    property <string> body: AppState.dialog == Dialog.block-all
        ? (AppState.dialog-count == 1 ? "1 device will be disconnected and refused. You can unblock it later in Blocked devices."
            : "\{AppState.dialog-count} devices will be disconnected and refused. You can unblock them later in Blocked devices.")
        : AppState.dialog == Dialog.restart
        ? (AppState.dialog-count == 0 ? "This restarts the hotspot."
            : AppState.dialog-count == 1 ? "This restarts the hotspot and disconnects 1 device."
            : "This restarts the hotspot and disconnects \{AppState.dialog-count} devices.")
        : AppState.dialog == Dialog.delete ? "This removes the profile and its list of blocked devices."
        : AppState.dialog-count == 1 ? "Closing this window stops the hotspot and disconnects 1 device."
        : "Closing this window stops the hotspot and disconnects \{AppState.dialog-count} devices.";
    property <string> confirm: AppState.dialog == Dialog.block-all ? "Block all"
        : AppState.dialog == Dialog.restart ? "Restart and apply" : AppState.dialog == Dialog.delete ? "Delete" : "Close and stop";
    Rectangle {
        x: 24px;
        y: 190px;
        width: parent.width - 48px;
        height: box.preferred-height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 14px;
        box := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.title;
                font-weight: 700;
                wrap: word-wrap;
            }
            Text {
                text: root.body;
                color: Theme.text-2;
                font-size: Theme.body;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Cancel";
                    kind: ButtonKind.secondary;
                    clicked => { AppState.dialog = Dialog.none; }
                }
                Button {
                    text: root.confirm;
                    kind: AppState.dialog == Dialog.restart ? ButtonKind.primary : ButtonKind.danger;
                    clicked => { AppState.confirm-dialog(); }
                }
            }
        }
    }
}

component InputDialog inherits Rectangle {
    background: Theme.dark ? #00000099 : #14181C73;
    TouchArea { }
    property <string> title: AppState.dialog == Dialog.rename ? "Rename device"
        : AppState.dialog == Dialog.time-limit ? "Allow for…" : "Limit speed";
    property <string> body: AppState.dialog == Dialog.rename ? "Shown instead of the name the device reports. Leave empty to use that name again."
        : AppState.dialog == Dialog.time-limit ? "The device is blocked when the time runs out. Ends when the hotspot stops."
        : "Applies to download and upload.";
    property <string> placeholder: AppState.dialog == Dialog.rename ? "Device name"
        : AppState.dialog == Dialog.time-limit ? "Custom: minutes" : "Custom: Mbit/s";
    Rectangle {
        x: 24px;
        y: 150px;
        width: parent.width - 48px;
        height: box.preferred-height;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 14px;
        box := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.title;
                font-weight: 700;
            }
            Text {
                text: root.body;
                color: Theme.text-2;
                font-size: Theme.small;
                wrap: word-wrap;
            }
            if AppState.dialog-presets.length > 0: HorizontalLayout {
                spacing: 8px;
                for preset[i] in AppState.dialog-presets: Button {
                    horizontal-stretch: 1;
                    small: true;
                    kind: ButtonKind.secondary;
                    text: preset;
                    clicked => { AppState.dialog-preset(i); }
                }
            }
            LineEdit {
                text <=> AppState.dialog-input;
                placeholder-text: root.placeholder;
                accepted => { AppState.dialog-apply(); }
            }
            if AppState.dialog-error != "": Text {
                text: AppState.dialog-error;
                color: Theme.error;
                font-size: Theme.caption;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                if AppState.dialog-can-remove: Button {
                    text: "Remove limit";
                    kind: ButtonKind.secondary-danger;
                    small: true;
                    clicked => { AppState.dialog-remove(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Cancel";
                    kind: ButtonKind.secondary;
                    small: true;
                    clicked => { AppState.dialog = Dialog.none; }
                }
                Button {
                    text: "Apply";
                    small: true;
                    clicked => { AppState.dialog-apply(); }
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    in property <bool> running;
    in property <bool> can-start;
    in property <bool> busy;
    in-out property <bool> autostart;
    callback show-window();
    callback toggle();
    callback autostart-toggled(bool);
    callback quit();
    icon: @image-url("icons/app.svg");
    title: "Hotspot";
    tooltip: busy ? "Hotspot: starting…" : running ? "Hotspot is on" : "Hotspot is off";
    clicked => { root.show-window(); }
    Menu {
        MenuItem {
            title: "Show Hotspot";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: root.running ? "Stop hotspot" : "Start hotspot";
            enabled: !root.busy && (root.running || root.can-start);
            activated => { root.toggle(); }
        }
        MenuItem {
            title: "Start at login";
            checkable: true;
            checked <=> root.autostart;
            activated => { root.autostart-toggled(self.checked); }
        }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

export component MainWindow inherits Window {
    title: "Hotspot";
    icon: @image-url("icons/app.svg");
    preferred-width: 400px;
    preferred-height: 640px;
    min-width: 360px;
    min-height: 520px;
    background: Theme.bg;

    if AppState.sheet == Sheet.none: MainView { }
    if AppState.sheet == Sheet.profile-new || AppState.sheet == Sheet.profile-edit: ProfileSheet { }
    if AppState.sheet == Sheet.blocked: BlockedSheet { }
    if AppState.sheet == Sheet.coupons: CouponsSheet { }
    if AppState.sheet == Sheet.users: UsersSheet { }
    if AppState.sheet == Sheet.settings: SettingsSheet { }
    if AppState.dialog == Dialog.restart || AppState.dialog == Dialog.delete || AppState.dialog == Dialog.close || AppState.dialog == Dialog.block-all: ConfirmDialog {
        width: parent.width;
        height: parent.height;
    }
    if AppState.dialog == Dialog.rename || AppState.dialog == Dialog.time-limit || AppState.dialog == Dialog.speed-limit: InputDialog {
        width: parent.width;
        height: parent.height;
    }
}
